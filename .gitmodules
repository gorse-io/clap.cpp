[submodule "ggml"]
	path = ggml
	url = https://github.com/ggml-org/ggml.git
[submodule "thirdparty/CLI11"]
	path = thirdparty/CLI11
	url = https://github.com/cliutils/cli11
[submodule "thirdparty/cpp-httplib"]
	path = thirdparty/cpp-httplib
	url = https://github.com/yhirose/cpp-httplib.git
[submodule "thirdparty/json"]
	path = thirdparty/json
	url = https://github.com/nlohmann/json.git
[submodule "thirdparty/icu"]
	path = thirdparty/icu
	url = https://github.com/unicode-org/icu.git
	shallow = true
[submodule "thirdparty/dr_libs"]
	path = thirdparty/dr_libs
	url = https://github.com/mackron/dr_libs.git
[submodule "thirdparty/minivorbis"]
	path = thirdparty/minivorbis
	url = https://github.com/edubart/minivorbis.git
