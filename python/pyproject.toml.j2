{% set backend = backend | default('cpu') -%}
{% set version = version | default('0.1.0') -%}
{% set package = 'clap_cpp' ~ ('_' ~ backend if backend != 'cpu' else '') -%}
# Generated from pyproject.toml.j2; render for cpu, cuda, rocm or vulkan.
[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = "{{ package | replace('_', '-') }}"
version = "{{ version }}"
description = "{{ 'Python bindings for clap.cpp audio and text embeddings' if backend == 'cpu' else backend | upper ~ ' backend for clap-cpp' }}"
readme = "README.md"
requires-python = ">=3.9"
license = "MIT"
license-files = ["LICENSE"]
dependencies = []
{% if backend == 'cpu' %}
[project.optional-dependencies]
test = ["pytest>=7", "mypy>=1.8", "typing_extensions>=4.2"]
cuda = ["clap-cpp-cuda=={{ version }}"]
rocm = ["clap-cpp-rocm=={{ version }}"]
vulkan = ["clap-cpp-vulkan=={{ version }}"]
{% endif %}
[tool.hatch.build]
exclude = ["**/__pycache__", "**/*.pyc", "**/.pytest_cache"]

[tool.hatch.build.targets.wheel]
packages = ["{{ package }}"]
# The explicitly copied native payload is ignored by Git, not by the wheel.
ignore-vcs = true

[tool.hatch.build.targets.wheel.hooks.custom]
path = "hatch_build.py"

[tool.hatch.build.targets.sdist]
# Never ship staged binaries, companion data or runtime notices in source archives.
include = ["/pyproject.toml", "/pyproject.toml.j2", "/README.md", "/LICENSE", "/hatch_build.py", "/{{ package }}/*.py", "/{{ package }}/*.pyi", "/{{ package }}/py.typed"{% if backend == 'cpu' %}, "/tests/**"{% endif %}]
{% if backend == 'cpu' %}
[tool.pytest.ini_options]
testpaths = ["tests"]
{% endif %}