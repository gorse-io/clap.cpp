"""Type declarations for the native clap.cpp extension."""

from collections.abc import Sequence
from os import PathLike
from types import TracebackType
from typing import Optional, Union, overload

class CLAP:
    def __init__(self, path: Union[str, PathLike[str]], threads: int = 0) -> None: ...
    @property
    def projection_dimension(self) -> int: ...
    @property
    def audio_sample_rate(self) -> int: ...
    def tokenize(self, text: str, max_length: int = 512) -> list[int]: ...
    @overload
    def encode_text(self, text: str) -> list[float]: ...
    @overload
    def encode_text(self, tokens: Sequence[int]) -> list[float]: ...
    @overload
    def encode_audio(
        self, pcm: Sequence[float], sample_rate: int = 48000, crop_offset: int = 0
    ) -> list[float]: ...
    @overload
    def encode_audio(
        self, path: Union[str, PathLike[str]], crop_offset: int = 0
    ) -> list[float]: ...
    def audio_frames(
        self, pcm: Sequence[float], sample_rate: int = 48000
    ) -> list[list[float]]: ...
    def clamp3_features(
        self, pcm: Sequence[float], sample_rate: int = 24000
    ) -> list[list[float]]: ...
    def close(self) -> None: ...
    def __enter__(self) -> CLAP: ...
    def __exit__(
        self,
        exc_type: Optional[type[BaseException]],
        exc_value: Optional[BaseException],
        traceback: Optional[TracebackType],
    ) -> None: ...
