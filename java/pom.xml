<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.gorse</groupId>
  <artifactId>clap-cpp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>clap.cpp Java bindings</name>
  <description>Java 11 bindings to the clap.cpp public C API using JNA.</description>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <clap.native.directory>${project.basedir}/../libraries</clap.native.directory>
    <clap.test.classesDirectory>${project.build.outputDirectory}</clap.test.classesDirectory>
    <jna.version>5.19.1</jna.version>
    <junit.version>5.11.4</junit.version>
  </properties>
  <dependencies>
    <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna</artifactId><version>${jna.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.aresstack</groupId><artifactId>huggingface4j</artifactId><version>0.1.1</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${clap.native.directory}/linux-x64/clap_cpp</directory>
        <targetPath>linux-x86-64</targetPath>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>${clap.native.directory}/linux-arm64/clap_cpp</directory>
        <targetPath>linux-aarch64</targetPath>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>${clap.native.directory}/darwin-arm64/clap_cpp</directory>
        <targetPath>darwin-aarch64</targetPath>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>${clap.native.directory}/win32-x64/clap_cpp</directory>
        <targetPath>win32-x86-64</targetPath>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>${clap.native.directory}/win32-arm64/clap_cpp</directory>
        <targetPath>win32-aarch64</targetPath>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>${project.basedir}/..</directory>
        <targetPath>META-INF</targetPath>
        <includes><include>LICENSE</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version><configuration><classesDirectory>${clap.test.classesDirectory}</classesDirectory><includes><include>**/TestClap.java</include></includes><failIfNoTests>true</failIfNoTests></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.3.1</version><configuration><excludeResources>true</excludeResources></configuration><executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions></plugin>
    </plugins>
  </build>
</project>
