{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "GGML_NATIVE": "OFF",
        "GGML_BACKEND_DL": "OFF",
        "GGML_OPENMP": "OFF",
        "HTTPLIB_USE_OPENSSL_IF_AVAILABLE": "OFF",
        "HTTPLIB_USE_ZLIB_IF_AVAILABLE": "OFF",
        "HTTPLIB_USE_BROTLI_IF_AVAILABLE": "OFF",
        "HTTPLIB_USE_ZSTD_IF_AVAILABLE": "OFF"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "release-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "GGML_METAL": "ON",
        "GGML_METAL_EMBED_LIBRARY": "ON"
      }
    },
    {
      "name": "windows-amd64-cpu",
      "inherits": "release-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "GGML_METAL": "OFF"
      }
    },
    {
      "name": "windows-arm64-cpu",
      "inherits": "release-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "ARM64",
      "toolset": "ClangCL",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "GGML_METAL": "OFF"
      }
    },
    {
      "name": "windows-amd64-cuda13.4",
      "inherits": "release-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "cuda=$env{CUDA_PATH}",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "GGML_METAL": "OFF",
        "GGML_CUDA": "ON",
        "GGML_STATIC": "ON"
      }
    },
    {
      "name": "windows-arm64-cuda13.4",
      "inherits": "release-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "ARM64",
      "toolset": "cuda=$env{CUDA_PATH}",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_CUDA_ARCHITECTURES": "75-virtual;80-virtual;86-real;89-real;90-virtual;120a-real;121a-real",
        "GGML_NATIVE": "ON",
        "GGML_METAL": "OFF",
        "GGML_CUDA": "ON",
        "GGML_STATIC": "ON"
      }
    },
    {
      "name": "windows-amd64-vulkan",
      "inherits": "release-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "GGML_METAL": "OFF",
        "GGML_VULKAN": "ON"
      }
    },
    {
      "name": "windows-arm64-vulkan",
      "inherits": "release-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "ARM64",
      "toolset": "ClangCL",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "GGML_METAL": "OFF",
        "GGML_VULKAN": "ON"
      }
    },
    {
      "name": "linux-amd64-cpu",
      "inherits": "release-base",
      "cacheVariables": {
        "GGML_METAL": "OFF"
      }
    },
    {
      "name": "linux-arm64-cpu",
      "inherits": "release-base",
      "cacheVariables": {
        "GGML_METAL": "OFF"
      }
    },
    {
      "name": "linux-riscv64-cpu",
      "inherits": "release-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "riscv64",
        "CMAKE_C_COMPILER": "riscv64-linux-gnu-gcc-14",
        "CMAKE_CXX_COMPILER": "riscv64-linux-gnu-g++-14",
        "CMAKE_EXE_LINKER_FLAGS": "-static",
        "GGML_METAL": "OFF",
        "GGML_RVV": "OFF",
        "GGML_RV_ZFH": "OFF",
        "GGML_RV_ZVFH": "OFF",
        "GGML_RV_ZICBOP": "OFF",
        "GGML_RV_ZIHINTPAUSE": "OFF"
      }
    },
    {
      "name": "linux-loong64-cpu",
      "inherits": "release-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "loongarch64",
        "CMAKE_C_COMPILER": "loongarch64-linux-gnu-gcc-14",
        "CMAKE_CXX_COMPILER": "loongarch64-linux-gnu-g++-14",
        "CMAKE_EXE_LINKER_FLAGS": "-static",
        "GGML_METAL": "OFF",
        "GGML_LSX": "OFF",
        "GGML_LASX": "OFF"
      }
    },
    {
      "name": "linux-amd64-cuda12.9",
      "inherits": "release-base",
      "cacheVariables": {
        "GGML_METAL": "OFF",
        "GGML_CUDA": "ON",
        "GGML_STATIC": "ON"
      }
    },
    {
      "name": "linux-arm64-cuda12.9",
      "inherits": "release-base",
      "cacheVariables": {
        "GGML_METAL": "OFF",
        "GGML_CUDA": "ON",
        "GGML_STATIC": "ON"
      }
    },
    {
      "name": "linux-amd64-rocm",
      "inherits": "release-base",
      "cacheVariables": {
        "CMAKE_HIP_COMPILER": "/opt/rocm/llvm/bin/clang++",
        "CMAKE_HIP_ARCHITECTURES": "gfx908;gfx90a;gfx942;gfx1030;gfx1100;gfx1101;gfx1200;gfx1201",
        "CMAKE_BUILD_RPATH": "/opt/rocm/lib",
        "GGML_METAL": "OFF",
        "GGML_HIP": "ON",
        "GGML_HIP_RCCL": "OFF",
        "GGML_STATIC": "OFF"
      }
    },
    {
      "name": "windows-amd64-rocm",
      "inherits": "release-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{ROCM_PATH}/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "$env{ROCM_PATH}/bin/clang++.exe",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "GPU_TARGETS": "gfx1030;gfx1100;gfx1101;gfx1102;gfx1151;gfx1200;gfx1201",
        "GGML_METAL": "OFF",
        "GGML_HIP": "ON",
        "GGML_HIP_RCCL": "OFF",
        "GGML_STATIC": "OFF"
      }
    },
    {
      "name": "linux-amd64-vulkan",
      "inherits": "release-base",
      "cacheVariables": {
        "GGML_METAL": "OFF",
        "GGML_VULKAN": "ON"
      }
    },
    {
      "name": "linux-arm64-vulkan",
      "inherits": "release-base",
      "cacheVariables": {
        "GGML_METAL": "OFF",
        "GGML_VULKAN": "ON"
      }
    }
