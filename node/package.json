{
  "name": "clap-cpp",
  "version": "0.1.0",
  "description": "Synchronous Node-API CPU bindings for clap.cpp audio and text embeddings",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/gorse-io/clap.cpp.git", "directory": "node" },
  "main": "index.js",
  "types": "index.d.ts",
  "engines": { "node": ">=22.0.0" },
  "files": ["index.js", "index.d.ts", "bindings.cpp", "CMakeLists.txt", "scripts", "native", "native-tests", "test/addon.test.js", "test/surface.test.js", "test/packaging.test.js", "test/generate-fixtures.py", "test/types.ts", "test/tsconfig.json", "README.md", "LICENSE", "THIRD_PARTY_LICENSES"],
  "scripts": {
    "install": "cmake-js compile",
    "build": "cmake-js compile",
    "rebuild": "cmake-js rebuild",
    "test:fixtures": "python3 test/generate-fixtures.py",
    "test": "node --test test/addon.test.js test/surface.test.js",
    "test:packaging": "node --test test/packaging.test.js",
    "test:types": "tsc -p test/tsconfig.json",
    "prepack": "node scripts/vendor.js"
  },
  "dependencies": { "cmake-js": "^8.0.0", "node-addon-api": "^8.9.2" },
  "devDependencies": { "typescript": "^5.9.3", "@types/node": "^22.0.0" }
}
